# Скопируйте в backend/.env и заполните. Секреты в репозиторий не добавляются.
DATABASE_URL=postgresql://archive:archive@localhost:5432/archive_dev?schema=public
TEST_DATABASE_URL=postgresql://archive:archive@localhost:5432/archive_test?schema=public

# Учётная запись главного администратора для локальной разработки (только development).
SEED_ADMIN_EMAIL=admin@archive.local
SEED_ADMIN_PASSWORD=change-me-please-12chars
# Демо-сотрудники archivist@archive.local и moderator@archive.local (только с набором demo, не в production).
SEED_DEMO_STAFF_PASSWORD=change-me-demo-12chars

# Наборы сидов: synthetic, demo, migrated. В production разрешён только migrated.
SEED_SETS=synthetic,demo,migrated
# Только для npm run db:diff (сверка схемы и миграций)
SHADOW_DATABASE_URL=postgresql://archive:archive@localhost:5432/archive_shadow?schema=public

# Файловое хранилище (сканы). Путь относительно backend/. В production будет MinIO.
STORAGE_DIR=storage

# Сервер API
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Поиск с ИИ (необязательно). none — только обычный поиск. ollama — локальная модель Ollama на этом компьютере:
# в модель уходят только названия и описания опубликованных открытых и ограниченных документов, закрытые — никогда.
# Если модель недоступна или отвечает дольше AI_TIMEOUT_MS, сайт молча работает обычным поиском.
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:11434
AI_EMBED_MODEL=bge-m3
AI_TIMEOUT_MS=4000

# Антивирус для загруженных файлов (S-013). none — файлы ждут проверки и на сайт не попадают.
# clamd — служба ClamAV на этом компьютере (см. README, «Антивирус для загруженных файлов»).
ANTIVIRUS_PROVIDER=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
ANTIVIRUS_TIMEOUT_MS=30000
ANTIVIRUS_INTERVAL_S=30
