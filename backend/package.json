{
  "name": "@archive-vko/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "ai:index": "tsx src/modules/ai/index-cli.ts",
    "antivirus:scan": "tsx src/modules/antivirus/scan-cli.ts"
  },
  "dependencies": {
    "@archive-vko/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
